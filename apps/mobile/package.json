    "@expo/metro-runtime": "57.0.14",
    "@gorhom/bottom-sheet": "5.2.14",
    "@tanstack/react-query": "5.102.8",
    "expo": "57.0.18",
    "expo-blur": "57.0.2",
    "expo-constants": "57.0.16",
    "expo-font": "57.0.2",
    "expo-haptics": "57.0.2",
    "expo-image": "57.0.3",
    "expo-linking": "57.0.8",
    "expo-router": "57.0.17",
    "expo-secure-store": "57.0.2",
    "expo-splash-screen": "57.0.8",
