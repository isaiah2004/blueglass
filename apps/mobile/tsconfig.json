{
  // TypeScript configuration for the Atlas Bible Expo client.
  //
  // Two bases are layered, in order:
  //   1. `expo/tsconfig.base` — the SDK's module/JSX/lib settings for React Native.
  //   2. `../../tsconfig.base.json` — the workspace's strictness rules, which must win.
  //
  // `.expo/types` holds the route union generated by `experiments.typedRoutes`, so it
  // has to be in `include` for `Href` to be typed.
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    // Node's ambient globals must never leak into React Native code — `setTimeout`
    // alone has an incompatible signature. The workspace root installs `@types/node`
    // for its tooling configs, and the hoisted node_modules layout would otherwise
    // auto-include it here.
    "types": [],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
