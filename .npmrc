# pnpm configuration for the Atlas Bible workspace.
#
# node-linker=hoisted is REQUIRED. React Native's Metro bundler and the Gradle /
# CocoaPods autolinking scripts resolve native modules by walking a real, flat
# node_modules tree. pnpm's default symlinked store breaks that resolution, so the
# whole workspace is installed with an npm-style hoisted layout instead.
node-linker=hoisted

# The React Native ecosystem ships loose and frequently contradictory peer ranges.
# Warn about them, never fail the install on them.
strict-peer-dependencies=false

# Every dependency is pinned to an exact version (rule 5.5.2), so `pnpm add` must
# not reintroduce a caret range.
save-exact=true
