# ─────────────────────────────────────────────────────────────────────────────
# Atlas Bible — environment template.
#
# Purpose
#   One file configures the whole local stack. `docker compose` reads it twice:
#   once to interpolate ${...} in docker-compose.yml (ports, credentials,
#   image tags), and once to inject variables into the `api` container.
#
# Usage
#   cp .env.example .env        # then edit .env, never this file
#
# Rules
#   - This file is committed. `.env` is gitignored (`.gitignore`: `.env.*` with
#     `!.env.example`). NEVER put a real key in this file.
#   - Every variable below is documented: what it does, format, and whether it
#     is required. Values here are safe local defaults, not secrets.
#   - Values shown are also the defaults compiled into docker-compose.yml, so an
#     empty `.env` still produces a working `db`.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1 · Database (service `db`)
# ═════════════════════════════════════════════════════════════════════════════

# Postgres superuser created on first boot.
# Format: identifier, lowercase. Required. Local-only credential — the database
# is never exposed beyond 127.0.0.1, so a memorable value is correct here.
POSTGRES_USER=atlas

# Password for POSTGRES_USER.
# Format: string. Required. Local development only. A deployed environment must
# take this from a secret manager and must not reuse this value.
POSTGRES_PASSWORD=atlas

# Database created on first boot.
# Format: identifier, lowercase. Required.
POSTGRES_DB=atlas

# Host port mapped to the container's 5432.
# Format: integer 1024-65535. Required.
# 5432 is a native Postgres on the author's machine and 5435 belongs to the
# Flutter prototype's compose stack — change this, not the container port, if
# 5436 is taken. See "Port conflicts" in docs/DEVELOPMENT.md.
DB_HOST_PORT=5436

# Connection string for tools running on the HOST (psql, loaders, pytest
# outside Docker). Format: postgresql://user:password@host:port/database.
# Optional — only host-side tooling reads it.
# NOTE: the `api` container does NOT use this value. docker-compose.yml derives
# the container's DATABASE_URL from POSTGRES_* and the service name `db`,
# because `localhost` inside a container is the container itself.
DATABASE_URL=postgresql://atlas:atlas@localhost:5436/atlas


# ═════════════════════════════════════════════════════════════════════════════
# 2 · API (service `api`)
# ═════════════════════════════════════════════════════════════════════════════

# Host port mapped to the container's 8000 (uvicorn).
# Format: integer 1024-65535. Required.
API_HOST_PORT=8010

# Python minor version used to build the API image (Dockerfile build arg).
# Format: major.minor matching a `python:<v>-slim-bookworm` tag. Required.
# The backend targets 3.12 (CLAUDE.md, Tech Stack).
PYTHON_VERSION=3.12

# Force watchfiles to poll instead of relying on inotify.
# Format: true | false. Required on Windows.
# WORKAROUND: inotify events do not cross the Windows -> WSL2 bind-mount
# boundary, so `uvicorn --reload` silently never reloads. Polling costs a little
# CPU. Set to `false` on a Linux or macOS host to get event-driven reloads back.
WATCHFILES_FORCE_POLLING=true

# Origins allowed to call the API, comma-separated.
# Format: comma-separated absolute origins, or `*`. Required.
# The prototype shipped `*` (data-inventory.md section 2). Closed here: this file
# ships an explicit list, and `docker compose` passes it into the api container,
# so the code default of `*` is never what actually runs locally.
# Ports: 8081 is Expo's Metro web server, 19006 the legacy expo-web port. Add
# your LAN origin when testing on a physical device.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Minimum severity emitted by the structured logger.
# Format: DEBUG | INFO | WARNING | ERROR | CRITICAL. Optional, default INFO.
LOG_LEVEL=INFO

# Deployment environment. Reported by GET /health.
# Format: local | test | staging | production. Optional, default local.
# It labels the instance; it does not switch behaviour.
ENVIRONMENT=local

# Name the service reports on GET /health.
# Format: identifier. Optional, default atlas-api.
SERVICE_NAME=atlas-api

# Translation used when a request names none.
# Format: a code present in the translations table. Optional, default KJVPCE.
# Load translations with:
#   docker compose exec api python -m scripts.load_scripture --all
DEFAULT_TRANSLATION=BSB

# Rows GET /search returns when the caller passes no limit, and the ceiling it
# clamps a larger request to. Format: integers. Optional, defaults 40 and 200.
# A caller asking for more gets the ceiling, not an error — refusing would just
# make the client retry with a smaller number and cost a round trip.
SEARCH_DEFAULT_LIMIT=40
SEARCH_MAX_LIMIT=200

# asyncpg pool bounds, per uvicorn worker.
# Format: integers. Optional, defaults 1 and 10.
# WARNING: workers × DB_POOL_MAX_SIZE must stay well under Postgres's
# max_connections (100 by default), or a rolling restart exhausts the server.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Per-connection dial timeout, seconds. Format: decimal. Optional, default 5.
DB_CONNECT_TIMEOUT_SECONDS=5

# DSN for the API's INTEGRATION tests. Unset by default, and that is deliberate:
# those tests SKIP rather than fail when there is no database, so the suite is
# runnable anywhere. Format: postgresql://user:password@host:port/database.
# From inside the api container the value is the container-side DATABASE_URL:
#   docker compose exec \
#     -e ATLAS_TEST_DATABASE_URL=postgresql://atlas:atlas@db:5432/atlas api pytest
# Every integration test runs inside a transaction that is rolled back, so
# pointing this at a database with real scripture loaded is safe.
ATLAS_TEST_DATABASE_URL=


# ═════════════════════════════════════════════════════════════════════════════
# 3 · AI provider — OpenRouter
# ═════════════════════════════════════════════════════════════════════════════

# OpenRouter API key. Format: `sk-or-v1-...`. REQUIRED for any AI feature;
# leave empty and the AI layer must degrade, not crash.
# Get one at https://openrouter.ai/keys. NEVER commit a real value: paste it
# into `.env` only. If a key ever reaches a commit, rotate it immediately.
OPENROUTER_API_KEY=

# OpenRouter API base. Format: absolute https URL. Optional.
# Override only to point at a proxy or a recorded-response fixture server.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hard spend ceiling in USD across ALL provider calls, enforced by the spend
# guard (packages/ai-guard, docs/architecture/ai-model-strategy.md section 4.2).
# Format: decimal USD. Optional — the guard defaults to 0.50 locally and 0.05
# under CI=true (packages/ai-guard/src/config.ts). 2.00 is NOT the default: it is
# ABSOLUTE_MAX_CEILING_USD, the hard cap this variable cannot be raised past, and
# the guard refuses to start if you try. The live key held $4.57 on 2026-08-28;
# the guard fails closed, so an automated test loop cannot drain it.
# The value below is the shipped default, not the cap.
ATLAS_AI_CEILING_USD=0.50

# Root directory for everything the guard writes — ledger and response cache.
# Format: directory path, relative to the process working directory. Optional.
# This is the one variable that relocates both at once. Gitignored via `.cache/`.
ATLAS_AI_DATA_DIR=.cache/ai

# Durable spend ledger path. Overrides the location derived from
# ATLAS_AI_DATA_DIR. Format: path. Optional.
# NOTE the `_PATH` suffix — it is the name packages/ai-guard/src/config.ts reads.
# Gitignored twice over: by `.cache/ai/` and by the `*.spend.json` pattern, so a
# ledger stays out of a commit even when you move it.
ATLAS_AI_LEDGER_PATH=.cache/ai/ledger.spend.json

# Disk cache for provider responses — a cache hit costs $0 and no ceiling.
# Overrides the location derived from ATLAS_AI_DATA_DIR.
# Format: directory path. Optional.
ATLAS_AI_CACHE_DIR=.cache/ai/responses

# Every other guard setting (ATLAS_AI_PRICE_CEILING_PER_MTOK,
# ATLAS_AI_REQUEST_TIMEOUT_MS, ATLAS_AI_MAX_ATTEMPTS, ATLAS_AI_MAX_CALLS_PER_PROCESS,
# ATLAS_AI_MAX_CALLS_PER_WINDOW) has a safe default and is documented with its
# range in packages/ai-guard/README.md. Set one only to tighten it.

# Model ids are NOT configured here. They live in the server's per-task model
# registry so a swap is one reviewed change, not an undocumented env edit.
# See docs/architecture/ai-model-strategy.md for the measured defaults.


# ═════════════════════════════════════════════════════════════════════════════
# 4 · Embeddings (service `embeddings`, compose profile `embeddings`)
# ═════════════════════════════════════════════════════════════════════════════
#
# Start with: docker compose --profile embeddings up -d embeddings
# OpenRouter sells no embedding models (verified: 0 of 388), so this is
# self-hosted at $0 per embedding — assumption Q-010.

# Model served by text-embeddings-inference.
# Format: HuggingFace repo id. Optional, default BAAI/bge-m3.
# BGE-M3 covers Greek and Hebrew, which the word-roots feature needs.
EMBEDDING_MODEL=BAAI/bge-m3

# Vector width the schema must declare for `vector(N)` columns.
# Format: integer. Optional. MUST match EMBEDDING_MODEL — BGE-M3 emits 1024,
# and 1024 sits inside pgvector's 2000-dimension HNSW limit.
# Changing the model without re-embedding every row corrupts retrieval.
EMBEDDING_DIMENSIONS=1024

# Host port mapped to the embeddings container's port 80.
# Format: integer 1024-65535. Optional.
EMBEDDINGS_HOST_PORT=8091

# The `api` container reaches the service by name; docker-compose.yml sets
# EMBEDDINGS_URL=http://embeddings:80 and ignores any value set here. Host-side
# scripts should use http://localhost:${EMBEDDINGS_HOST_PORT}.


# ═════════════════════════════════════════════════════════════════════════════
# 5 · Client (apps/mobile)
# ═════════════════════════════════════════════════════════════════════════════

# API base URL the Expo client calls.
# Format: absolute http(s) URL. Required once the client talks to the network.
# `localhost` works for iOS simulator and web. Android emulator must use
# http://10.0.2.2:8010, and a physical device needs your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8010
